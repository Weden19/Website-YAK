RewriteEngine On

# Redirect old file-based URLs to clean paths
RewriteRule ^index\.html$ /main/ [R=301,L]
RewriteRule ^rules\.html$ /rules/ [R=301,L]
RewriteRule ^members\.html$ /members/ [R=301,L]

# Canonicalize /main, /rules, /members to directory URLs
RewriteRule ^main/?$ /main/ [R=301,L]
RewriteRule ^rules/?$ /rules/ [R=301,L]
RewriteRule ^members/?$ /members/ [R=301,L]
